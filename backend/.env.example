APP_NAME="Sentriq AI Backend"
APP_ENV=development
DEBUG=True

# Database (PostgreSQL or local SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./sentriq.db

# Supabase Auth & Database (Optional for hosted integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=

# AI & Threat Intelligence Providers
GEMINI_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# CORS Allowed Origins (Comma separated or json array)
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","capacitor://localhost","*"]

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10
